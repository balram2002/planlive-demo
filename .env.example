# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. Do NOT commit .env.local.
# This demo reuses the same env vars as the main planLive app — you can copy
# these values straight from that project's .env.local.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. MUST be a replica set (Atlas is by default)
# — stock decrements use multi-document transactions.
DATABASE_URL=

# LiveKit (https://cloud.livekit.io)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ImageKit (optional — if unset, product/thumbnail uploads fall back to local
# disk storage at /public/uploads).
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=
