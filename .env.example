# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. Do NOT commit .env.local.
# This demo reuses the same env vars as the main planLive app — you can copy
# these values straight from that project's .env.local.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. MUST be a replica set (Atlas is by default)
# — stock decrements use multi-document transactions. MUST include a database
# name in the path (Prisma's Mongo connector fails with "empty database name
# not allowed" otherwise) — use a DIFFERENT database than production, since
# this app's schema (Product/Stream/Order only) isn't compatible with it:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/livewab_demo?retryWrites=true&w=majority
DATABASE_URL=

# LiveKit (https://cloud.livekit.io)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ImageKit (optional — if unset, product/thumbnail uploads fall back to local
# disk storage at /public/uploads).
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# Required to unlock the hidden seller studio page. Pick any string — this is
# the only thing standing between a visitor and the ability to add products /
# go live, so don't leave it unset or trivially guessable.
SELLER_PASSWORD=
